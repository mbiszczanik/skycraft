      "seed": 300007, "version": 1, "versionNonce": 300008, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "p2t", "x": 314, "y": 414, "width": 240, "height": 76,
      "text": "SAS token\n  scoped and time limited\n  ad-hoc SAS cannot be\n  revoked before expiry\n  policy-backed SAS can",
      "originalText": "SAS token\n  scoped and time limited\n  ad-hoc SAS cannot be\n  revoked before expiry\n  policy-backed SAS can",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
