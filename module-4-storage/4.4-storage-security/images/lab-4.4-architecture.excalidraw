    {
      "type": "text", "id": "ev_t", "x": 36, "y": 562, "width": 780, "height": 90,
      "text": "az storage account update -n prodskycraftswcsa --default-action Deny\n\naz storage account network-rule add -n prodskycraftswcsa \\\n  --vnet-name prod-skycraft-swc-vnet --subnet WorldSubnet\n\naz role assignment create --role \"Storage Blob Data Contributor\" \\\n  --assignee <objectId> --scope <storage account id>",
