    {
      "type": "text", "id": "p1t", "x": 34, "y": 414, "width": 240, "height": 76,
      "text": "account key\n  full control, cannot be\n  scoped or expired\n  rotate it and everything\n  using it breaks",
      "originalText": "account key\n  full control, cannot be\n  scoped or expired\n  rotate it and everything\n  using it breaks",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300005, "version": 1, "versionNonce": 300006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
