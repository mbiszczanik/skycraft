    {
      "type": "text", "id": "ev_t", "x": 36, "y": 364, "width": 780, "height": 83,
      "text": "snapshot     \"give me the share as it was on Tuesday\"   you must take it in advance\nsoft delete  \"I deleted that by accident an hour ago\"    automatic, 14 day window\n\n# a snapshot survives deletion of the file, soft delete does not survive\n# deletion of the share itself - that is what a lock in Lab 1.3 is for",
      "originalText": "snapshot     \"give me the share as it was on Tuesday\"   you must take it in advance\nsoft delete  \"I deleted that by accident an hour ago\"    automatic, 14 day window\n\n# a snapshot survives deletion of the file, soft delete does not survive\n# deletion of the share itself - that is what a lock in Lab 1.3 is for",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
