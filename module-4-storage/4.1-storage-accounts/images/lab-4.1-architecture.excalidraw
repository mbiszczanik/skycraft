    {
      "type": "text", "id": "ev1_t", "x": 36, "y": 520, "width": 780, "height": 75,
      "text": "az storage account create -n prodskycraftswcsa -g prod-skycraft-swc-rg \\\n  -l swedencentral --sku Standard_GRS --kind StorageV2 \\\n  --access-tier Hot --min-tls-version TLS1_2 \\\n  --allow-blob-public-access false\n# name already taken -> the error is StorageAccountAlreadyTaken, globally",
      "originalText": "az storage account create -n prodskycraftswcsa -g prod-skycraft-swc-rg \\\n  -l swedencentral --sku Standard_GRS --kind StorageV2 \\\n  --access-tier Hot --min-tls-version TLS1_2 \\\n  --allow-blob-public-access false\n# name already taken -> the error is StorageAccountAlreadyTaken, globally",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
