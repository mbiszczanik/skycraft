    {
      "type": "text", "id": "s2_t2", "x": 454, "y": 306, "width": 370, "height": 55,
      "text": "tier-game-logs      game-logs   Hot→Cool→Archive\narchive-backups     player-backups  →Archive\n\n# rules target a prefix, evaluated once a day",
      "originalText": "tier-game-logs      game-logs   Hot→Cool→Archive\narchive-backups     player-backups  →Archive\n\n# rules target a prefix, evaluated once a day",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300013, "version": 1, "versionNonce": 300014, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "s2_note", "x": 20, "y": 386, "width": 820, "height": 15,
      "text": "Soft delete protects against your mistakes. It does not protect against a deleted storage account.",
      "originalText": "Soft delete protects against your mistakes. It does not protect against a deleted storage account.",
