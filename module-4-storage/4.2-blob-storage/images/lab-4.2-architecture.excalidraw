    {
      "type": "text", "id": "ev1_l", "x": 20, "y": 428, "width": 460, "height": 14,
      "text": "az CLI — container, then the account-wide switches",
      "originalText": "az CLI — container, then the account-wide switches",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700001, "version": 1, "versionNonce": 700002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "ev1_r", "x": 20, "y": 446, "width": 400, "height": 100,
      "strokeColor": "#cbd5e1", "backgroundColor": "#e2e8f0", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700003, "version": 1, "versionNonce": 700004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "ev1_t", "x": 34, "y": 458, "width": 370, "height": 76,
      "text": "az storage container create \\\n  -n game-assets --public-access off\n\naz storage account blob-service-properties \\\n  update --enable-delete-retention true \\\n  --delete-retention-days 7 --enable-versioning",
      "originalText": "az storage container create \\\n  -n game-assets --public-access off\n\naz storage account blob-service-properties \\\n  update --enable-delete-retention true \\\n  --delete-retention-days 7 --enable-versioning",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700005, "version": 1, "versionNonce": 700006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "ev2_l", "x": 440, "y": 428, "width": 400, "height": 14,
      "text": "the cost of Archive is not storage, it is time",
      "originalText": "the cost of Archive is not storage, it is time",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700007, "version": 1, "versionNonce": 700008, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "ev2_r", "x": 440, "y": 446, "width": 400, "height": 100,
      "strokeColor": "#cbd5e1", "backgroundColor": "#e2e8f0", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700009, "version": 1, "versionNonce": 700010, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "ev2_t", "x": 454, "y": 458, "width": 370, "height": 76,
      "text": "an Archive blob is offline\nreading it needs a rehydration first\n  Standard priority  up to 15 hours\n  High priority      under 1 hour\n# plan restores, do not improvise them",
      "originalText": "an Archive blob is offline\nreading it needs a rehydration first\n  Standard priority  up to 15 hours\n  High priority      under 1 hour\n# plan restores, do not improvise them",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
