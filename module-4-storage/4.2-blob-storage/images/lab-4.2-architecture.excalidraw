    {
      "type": "text", "id": "s2_t1", "x": 34, "y": 306, "width": 370, "height": 55,
      "text": "soft delete   7 days, blobs and snapshots\nversioning    every overwrite keeps the old one\n\n# both apply to all containers, always",
      "originalText": "soft delete   7 days, blobs and snapshots\nversioning    every overwrite keeps the old one\n\n# both apply to all containers, always",
