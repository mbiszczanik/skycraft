    {
      "type": "text", "id": "ev_t", "x": 36, "y": 284, "width": 780, "height": 98,
      "text": "\"tierToCool\":     { \"daysAfterModificationGreaterThan\":  30 }\n\"tierToCold\":     { \"daysAfterModificationGreaterThan\":  90 }\n\"tierToArchive\":  { \"daysAfterModificationGreaterThan\": 180 }\n\"delete\":         { \"daysAfterModificationGreaterThan\": 365 }\n\n# days count from LAST MODIFICATION, not from creation\n# the engine runs once a day, so a transition is not instant",
      "originalText": "\"tierToCool\":     { \"daysAfterModificationGreaterThan\":  30 }\n\"tierToCold\":     { \"daysAfterModificationGreaterThan\":  90 }\n\"tierToArchive\":  { \"daysAfterModificationGreaterThan\": 180 }\n\"delete\":         { \"daysAfterModificationGreaterThan\": 365 }\n\n# days count from LAST MODIFICATION, not from creation\n# the engine runs once a day, so a transition is not instant",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700005, "version": 1, "versionNonce": 700006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
