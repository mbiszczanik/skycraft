    {
      "type": "text", "id": "ev1_t", "x": 36, "y": 646, "width": 780, "height": 90,
      "text": "az network dns record-set a add-record -g platform-skycraft-swc-rg \\\n  -z skycraft.example.com -n dev -a 203.0.113.10 --ttl 300\n\naz network private-dns link vnet create -g platform-skycraft-swc-rg \\\n  -z skycraft.internal -n dev-vnet-link -v dev-skycraft-swc-vnet -e true\n# -e true enables autoregistration: VMs publish their own A records",
      "originalText": "az network dns record-set a add-record -g platform-skycraft-swc-rg \\\n  -z skycraft.example.com -n dev -a 203.0.113.10 --ttl 300\n\naz network private-dns link vnet create -g platform-skycraft-swc-rg \\\n  -z skycraft.internal -n dev-vnet-link -v dev-skycraft-swc-vnet -e true\n# -e true enables autoregistration: VMs publish their own A records",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
