      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "ev1_r", "x": 20, "y": 480, "width": 820, "height": 112,
      "strokeColor": "#cbd5e1", "backgroundColor": "#e2e8f0", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700003, "version": 1, "versionNonce": 700004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "ev1_t", "x": 36, "y": 492, "width": 780, "height": 90,
      "text": "az network vnet peering create \\\n  --name hub-to-dev \\\n  --resource-group platform-skycraft-swc-rg \\\n  --vnet-name platform-skycraft-swc-vnet \\\n  --remote-vnet $devVnetId --allow-vnet-access --allow-forwarded-traffic\n# then the mirror: dev-to-hub, swapping rg / vnet / remote",
      "originalText": "az network vnet peering create \\\n  --name hub-to-dev \\\n  --resource-group platform-skycraft-swc-rg \\\n  --vnet-name platform-skycraft-swc-vnet \\\n  --remote-vnet $devVnetId --allow-vnet-access --allow-forwarded-traffic\n# then the mirror: dev-to-hub, swapping rg / vnet / remote",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700005, "version": 1, "versionNonce": 700006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "ev2_l", "x": 20, "y": 604, "width": 380, "height": 14,
      "text": "peering properties once both directions exist",
