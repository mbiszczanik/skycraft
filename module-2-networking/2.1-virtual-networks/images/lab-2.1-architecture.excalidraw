    {
      "type": "text", "id": "ev1_l", "x": 20, "y": 462, "width": 400, "height": 14,
      "text": "az CLI — one peering object per direction, so you create it twice",
      "originalText": "az CLI — one peering object per direction, so you create it twice",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
