    {
      "type": "text", "id": "ev1_t", "x": 36, "y": 758, "width": 780, "height": 90,
      "text": "az network nsg rule create \\\n  --nsg-name dev-skycraft-swc-auth-nsg \\\n  --name Allow-SSH-Bastion --priority 100 \\\n  --source-address-prefixes 10.0.0.0/26 \\\n  --destination-port-ranges 22 --access Allow\n# custom range 100-4096 · lower is evaluated first",
      "originalText": "az network nsg rule create \\\n  --nsg-name dev-skycraft-swc-auth-nsg \\\n  --name Allow-SSH-Bastion --priority 100 \\\n  --source-address-prefixes 10.0.0.0/26 \\\n  --destination-port-ranges 22 --access Allow\n# custom range 100-4096 · lower is evaluated first",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
