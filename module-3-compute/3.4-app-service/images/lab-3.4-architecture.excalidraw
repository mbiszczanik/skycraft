    {
      "type": "text", "id": "ev1_t", "x": 36, "y": 500, "width": 780, "height": 75,
      "text": "az webapp deploy --resource-group dev-skycraft-swc-rg \\\n  --name dev-skycraft-swc-app01 --slot staging \\\n  --src-path app.zip --type zip\n\naz webapp deployment slot swap -g dev-skycraft-swc-rg \\\n  -n dev-skycraft-swc-app01 --slot staging --target-slot production",
