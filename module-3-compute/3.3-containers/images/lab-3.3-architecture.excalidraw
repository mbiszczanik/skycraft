    {
      "type": "text", "id": "s2_t1", "x": 34, "y": 372, "width": 370, "height": 69,
      "text": "starts fast, billed per second\nno ingress controller, no scaling\nno revision history\n\ngood for: batch jobs, build agents,\n          a single always-on sidecar",
      "originalText": "starts fast, billed per second\nno ingress controller, no scaling\nno revision history\n\ngood for: batch jobs, build agents,\n          a single always-on sidecar",
