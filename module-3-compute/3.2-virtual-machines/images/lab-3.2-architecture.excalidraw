    {
      "type": "text", "id": "ev1_t", "x": 36, "y": 556, "width": 780, "height": 90,
      "text": "az vm create -g dev-skycraft-swc-rg -n dev-skycraft-swc-auth-vm \\\n  --image Ubuntu2204 --size Standard_B2ls_v2 --zone 1 \\\n  --vnet-name dev-skycraft-swc-vnet --subnet AuthSubnet \\\n  --public-ip-address \"\" \\\n  --os-disk-size-gb 30 --storage-sku StandardSSD_LRS\n# --public-ip-address \"\" is what keeps the VM off the internet",
      "originalText": "az vm create -g dev-skycraft-swc-rg -n dev-skycraft-swc-auth-vm \\\n  --image Ubuntu2204 --size Standard_B2ls_v2 --zone 1 \\\n  --vnet-name dev-skycraft-swc-vnet --subnet AuthSubnet \\\n  --public-ip-address \"\" \\\n  --os-disk-size-gb 30 --storage-sku StandardSSD_LRS\n# --public-ip-address \"\" is what keeps the VM off the internet",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
