    {
      "type": "text", "id": "ev_t", "x": 36, "y": 502, "width": 780, "height": 90,
      "text": "Heartbeat\n| summarize LastHeartbeat = max(TimeGenerated) by Computer\n# no rows here means the DCR is missing or the agent is not associated\n\nPerf\n| where CounterName == \"% Processor Time\"\n| summarize avg(CounterValue) by bin(TimeGenerated, 5m), Computer",
      "originalText": "Heartbeat\n| summarize LastHeartbeat = max(TimeGenerated) by Computer\n# no rows here means the DCR is missing or the agent is not associated\n\nPerf\n| where CounterName == \"% Processor Time\"\n| summarize avg(CounterValue) by bin(TimeGenerated, 5m), Computer",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 700005, "version": 1, "versionNonce": 700006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    }
