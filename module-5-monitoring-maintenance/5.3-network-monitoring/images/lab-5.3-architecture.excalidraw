    {
      "type": "text", "id": "q1", "x": 86, "y": 121, "width": 740, "height": 18,
      "text": "\"is an NSG rule dropping this packet?\"",
      "originalText": "\"is an NSG rule dropping this packet?\"",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 220001, "version": 1, "versionNonce": 220002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "t1", "x": 86, "y": 143, "width": 740, "height": 30,
      "text": "IP Flow Verify — you give it source, destination, port and direction,\nit names the exact rule that allowed or denied the packet",
      "originalText": "IP Flow Verify — you give it source, destination, port and direction,\nit names the exact rule that allowed or denied the packet",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 220003, "version": 1, "versionNonce": 220004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "q2", "x": 86, "y": 176, "width": 740, "height": 18,
      "text": "\"where does this traffic actually go?\"",
      "originalText": "\"where does this traffic actually go?\"",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 220005, "version": 1, "versionNonce": 220006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "t2", "x": 86, "y": 198, "width": 740, "height": 30,
      "text": "Next Hop — returns the hop type and the route that produced it,\nwhich is how you catch a user-defined route you forgot about",
      "originalText": "Next Hop — returns the hop type and the route that produced it,\nwhich is how you catch a user-defined route you forgot about",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 220007, "version": 1, "versionNonce": 220008, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "q3", "x": 86, "y": 231, "width": 740, "height": 18,
      "text": "\"can A reach B right now, end to end?\"",
      "originalText": "\"can A reach B right now, end to end?\"",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 220009, "version": 1, "versionNonce": 220010, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "t3", "x": 86, "y": 253, "width": 740, "height": 30,
      "text": "Connection Troubleshoot — sends real traffic and reports every hop,\nso it sees the things a rule check cannot: a dead service, a full disk",
      "originalText": "Connection Troubleshoot — sends real traffic and reports every hop,\nso it sees the things a rule check cannot: a dead service, a full disk",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 220011, "version": 1, "versionNonce": 220012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "s1_note", "x": 20, "y": 294, "width": 820, "height": 15,
      "text": "The first two evaluate configuration. Only the third proves that traffic actually flows.",
      "originalText": "The first two evaluate configuration. Only the third proves that traffic actually flows.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
