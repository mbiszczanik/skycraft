    {
      "type": "text", "id": "ev_t", "x": 36, "y": 534, "width": 780, "height": 90,
      "text": "az network watcher test-ip-flow \\\n  --vm dev-skycraft-swc-auth-vm -g dev-skycraft-swc-rg \\\n  --direction Inbound --protocol TCP \\\n  --local 10.1.1.10:8080 --remote 10.0.0.4:60000\n\n# answer: Deny, and the name of the rule that did it — usually DenyAllInBound",
      "originalText": "az network watcher test-ip-flow \\\n  --vm dev-skycraft-swc-auth-vm -g dev-skycraft-swc-rg \\\n  --direction Inbound --protocol TCP \\\n  --local 10.1.1.10:8080 --remote 10.0.0.4:60000\n\n# answer: Deny, and the name of the rule that did it — usually DenyAllInBound",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
