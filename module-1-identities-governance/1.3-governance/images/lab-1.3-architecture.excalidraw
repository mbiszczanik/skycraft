    {
      "type": "text", "id": "c1d", "x": 20, "y": 180, "width": 270, "height": 69,
      "text": "blocks creation\n\nRequire a tag on resources\nAllowed locations:\n  swedencentral, northeurope",
      "originalText": "blocks creation\n\nRequire a tag on resources\nAllowed locations:\n  swedencentral, northeurope",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210013, "version": 1, "versionNonce": 210014, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "c2d", "x": 300, "y": 180, "width": 270, "height": 69,
      "text": "blocks deletion\n\nCanNotDelete on\n  prod-skycraft-swc-rg\n  platform-skycraft-swc-rg",
      "originalText": "blocks deletion\n\nCanNotDelete on\n  prod-skycraft-swc-rg\n  platform-skycraft-swc-rg",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210015, "version": 1, "versionNonce": 210016, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "c3d", "x": 580, "y": 180, "width": 270, "height": 69,
      "text": "blocks nothing\n\nSkyCraft-Monthly-Budget\n  $100, monthly reset\n  alerts at 50 / 80 / 100 %",
      "originalText": "blocks nothing\n\nSkyCraft-Monthly-Budget\n  $100, monthly reset\n  alerts at 50 / 80 / 100 %",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210017, "version": 1, "versionNonce": 210018, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "s1_note", "x": 20, "y": 258, "width": 800, "height": 15,
      "text": "A budget never stops a deployment. It sends email. Cost control comes from policy, not from the budget.",
      "originalText": "A budget never stops a deployment. It sends email. Cost control comes from policy, not from the budget.",
