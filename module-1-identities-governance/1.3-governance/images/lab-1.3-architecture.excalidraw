    {
      "type": "text", "id": "ev1_t", "x": 36, "y": 478, "width": 780, "height": 90,
      "text": "az policy assignment create --name allowed-locations \\\n  --policy e56962a6-4747-49cd-b67b-bf8b01975c4c \\\n  --scope /subscriptions/<id> \\\n  --params '{\"listOfAllowedLocations\":{\"value\":[\"swedencentral\",\"northeurope\"]}}'\n\naz lock create -n prod-no-delete --lock-type CanNotDelete -g prod-skycraft-swc-rg",
      "originalText": "az policy assignment create --name allowed-locations \\\n  --policy e56962a6-4747-49cd-b67b-bf8b01975c4c \\\n  --scope /subscriptions/<id> \\\n  --params '{\"listOfAllowedLocations\":{\"value\":[\"swedencentral\",\"northeurope\"]}}'\n\naz lock create -n prod-no-delete --lock-type CanNotDelete -g prod-skycraft-swc-rg",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#166534", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
