    {
      "type": "text", "id": "ev1_t", "x": 34, "y": 570, "width": 430, "height": 83,
      "text": "az role assignment create \\\n  --assignee-object-id <group objectId> \\\n  --assignee-principal-type Group \\\n  --role Contributor \\\n  --scope /subscriptions/<id>/resourceGroups/dev-skycraft-swc-rg",
